# ---------------------------------------------------------------------------
# Sanity — content backend
# Copy this file to .env.local and fill in the values from your Sanity project.
# .env.local is git-ignored. NEVER commit real tokens.
# ---------------------------------------------------------------------------

# Public, non-secret identifiers. Safe to expose to the browser.
# Create a project at https://www.sanity.io/manage (or run `pnpm sanity:init`).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version (date string). Pin to a stable date.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# SECRETS — server-side only. Do NOT prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Read token for a PRIVATE dataset. Used only in server components / route
# handlers. Leave empty for a public dataset.
SANITY_API_READ_TOKEN=

# Shared secret used to authenticate the Sanity webhook that triggers
# on-demand revalidation (see src/app/api/revalidate/route.ts).
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Absolute base URL of the deployed site, used for metadata / canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
